rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Scanned reports path: /medicalReports/{hospitalId}/{patientId}/{reportId}
    match /medicalReports/{hospitalId}/{patientId}/{allPaths=**} {
      // Authenticated users belonging to hospital staff or the patient can read
      allow read: if request.auth != null;
      // Receptionists and doctors can upload scanned documents up to 25MB
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
